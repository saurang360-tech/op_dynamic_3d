  <diagram id="03" name="03 Simulation step">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03 / ONE SIMULATION STEP — X is an N × 2 matrix of agent opinions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1250" height="75" as="geometry" />
