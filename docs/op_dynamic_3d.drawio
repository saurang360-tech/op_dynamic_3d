        <mxCell id="legend" value="HOW TO READ&#10;Blue: current behavior&#10;Green: configuration / stored data&#10;Yellow: decision • Orange: caveat&#10;Purple + dashed arrows: proposals only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="400" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="init" value="Before run&#10;Initialize X, Phi, activities and p_conn" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="save" value="Start time step&#10;Save current X and time to history" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="method" value="Integrator?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="euler" value="Euler: one RHS evaluation&#10;X ← X + dt × derivative" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rk4" value="RK4: four RHS evaluations&#10;k1, k2, k3, k4 at stage states&#10;Weighted derivative updates X" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="660" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="more" value="More time steps?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="done" value="Finish&#10;self._opinions = final endpoint&#10;result.y = pre-step history" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rhs" value="INSIDE EACH RHS / op_dynamics(t, stage X)&#10;Increment persistent RHS-call counter" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="140" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="refresh" value="Every 10th RHS call?&#10;Refresh p_conn using self._opinions&#10;(not the supplied stage X)" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="310" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="adj" value="Sample fresh adjacency A&#10;Activate agents by activity probability&#10;Choose m distinct targets per active source&#10;A[target, source] = 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="510" width="290" height="160" as="geometry" />
        </mxCell>
        <mxCell id="influence" value="Transform stage X with Phi&#10;g = tanh(topic-specific alpha × X Phi)&#10;derivative = −X + K × A g" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="720" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rdn" value="RDN enabled?&#10;Method 1: sample n agents&#10;nudge = sqrt(n) × (sample mean − global mean)&#10;Add D × nudge to every agent in chosen topic&#10;Method 0: leave derivative unchanged" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="910" width="290" height="160" as="geometry" />
        </mxCell>
        <mxCell id="return" value="Return derivative to integrator" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="1130" width="290" height="125" as="geometry" />
        </mxCell>
