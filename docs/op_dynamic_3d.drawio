        <mxCell id="proposal" value="PROPOSED CHANGE — duplicate this box&#10;Describe idea, reason, and expected result.&#10;Connect with a dashed arrow." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;spacing=10;" vertex="1" parent="1">
